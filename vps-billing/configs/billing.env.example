# Copy to /etc/vps-billing/billing.env and reference it from the systemd
# units in configs/systemd/. Keep this file out of version control once you
# fill in real values (it's already covered by vps-billing/.gitignore).

BILLING_DB=/var/lib/vps-billing/billing.db
XRAY_BIN=/usr/local/bin/xray
XRAY_API=127.0.0.1:10085
BILLING_PROTOCOL=vless
# Only set BILLING_FLOW if your inbound requires a specific vless flow
# (e.g. xtls-rprx-vision) — it must match the inbound's own setting exactly.
BILLING_FLOW=
# See docs/DEPLOY.md "设备数限制的真实能力" before turning this on.
BILLING_ENFORCE_DEVICE_LIMIT=false

# Optional: set these to have `sub create`/`sub link` print a ready-to-scan
# vless:// share link + terminal QR code. Leave BILLING_HOST empty to skip
# link generation entirely.
BILLING_HOST=
BILLING_PORT=443
BILLING_SECURITY=reality
BILLING_SNI=
BILLING_PUBLIC_KEY=
BILLING_SHORT_ID=
BILLING_FINGERPRINT=chrome
BILLING_NETWORK=tcp
